    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$([System.IO.Path]::Combine('$(CloverPit)', 'CloverPit_Data', 'Managed', 'UnityEngine.InputLegacyModule.dll'))" />
  </ItemGroup>
</Project>