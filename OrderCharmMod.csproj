    <Reference Include="Unity.TextMeshPro" HintPath="$([System.IO.Path]::Combine('$(CloverPit)', 'CloverPit_Data', 'Managed', 'Unity.TextMeshPro.dll'))" />
    <Reference Include="UnityEngine.UI" HintPath="$([System.IO.Path]::Combine('$(CloverPit)', 'CloverPit_Data', 'Managed', 'UnityEngine.UI.dll'))" />
